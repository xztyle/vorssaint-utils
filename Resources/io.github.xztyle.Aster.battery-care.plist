<plist version="1.0"><dict>
    <key>Label</key><string>io.github.xztyle.Aster.battery-care</string>
    <key>BundleProgram</key><string>Contents/Library/LaunchServices/io.github.xztyle.Aster.battery-care</string>
    <key>MachServices</key><dict><key>io.github.xztyle.Aster.battery-care</key><true/></dict>
    <key>RunAtLoad</key><true/>
